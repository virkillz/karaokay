{
  "name": "karaokay",
  "productName": "Karaokay",
  "version": "0.1.0",
  "private": true,
  "description": "Local karaoke player",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "any-ascii": "^0.3.3",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^4.1.0",
    "music-metadata": "^12.4.0",
    "onnxruntime-node": "^1.31.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/rebuild": "^4.2.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "essentia.js": "^0.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "signalsmith-stretch": "^1.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "local.karaokay.app",
    "productName": "Karaokay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/win32/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/darwin/x64/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/onnxruntime-node/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null
    },
    "dmg": {
      "title": "Karaokay"
    },
    "fileAssociations": [
      {
        "ext": "karaokay",
        "name": "Karaokay Song",
        "description": "Karaokay song package",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.karaokay+zip"
      }
    ]
  }
}
